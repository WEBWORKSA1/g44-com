---
layout: null
sitemap: false
search: false
---
[{%- assign first = true -%}{%- for p in site.pages -%}{%- if p.title and p.search != false -%}{%- unless first -%},{%- endunless -%}{%- assign first = false -%}{"title":{{ p.title | jsonify }},"url":{{ p.url | jsonify }},"description":{{ p.description | default: "" | jsonify }},"code":{{ p.code | default: "" | jsonify }},"keywords":{{ p.keywords | default: "" | jsonify }}}{%- endif -%}{%- endfor -%}]
